# 이 파일을 secrets.toml 로 복사한 뒤 값을 채우세요. (secrets.toml 은 깃에 올라가지 않습니다)
# Streamlit Community Cloud에서는 앱 설정 > Secrets 에 같은 내용을 붙여 넣습니다.

OPENAI_API_KEY = "sk-..."

# 앱 접속 비밀번호(권장). 인터넷에 배포하면 주소를 아는 누구나 접속할 수 있으므로
# 내 API 요금이 도용되지 않도록 꼭 설정하세요.
APP_PASSWORD = "원하는-비밀번호"

# (선택) 사용할 모델. 비워 두면 app.py 의 DEFAULT_MODEL 을 씁니다.
# OPENAI_MODEL = "gpt-5.6-terra"
# (선택) 조문 후보 선정에만 쓸 더 빠른 모델
# OPENAI_MODEL_FAST = ""
# (선택) OpenAI 호환 API를 쓰는 다른 서비스로 보낼 때의 주소
# OPENAI_BASE_URL = ""
# (선택) 개선 요청서 PDF의 점검자 칸에 미리 채울 이름
# REPORT_INSPECTOR = ""

# (권장) 통계 리포트용 판독 기록을 오래 보관할 GitHub 저장소.
# 설정하지 않으면 기록이 앱 서버에 임시 저장되어, 앱이 재시작될 때 지워질 수 있습니다.
# GITHUB_TOKEN: GitHub > Settings > Developer settings > Fine-grained tokens 에서
#   이 저장소만 선택하고 Repository permissions > Contents 를 Read and write 로 준 토큰
# GITHUB_TOKEN = "github_pat_..."
# GITHUB_REPO = "아이디/저장소이름"
# (선택) 기록을 저장할 브랜치. 앱 배포 브랜치와 달라야 저장할 때마다 앱이 재배포되지 않습니다.
# GITHUB_DATA_BRANCH = "app-data"
