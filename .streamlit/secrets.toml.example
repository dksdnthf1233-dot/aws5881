# 이 파일을 secrets.toml 로 복사한 뒤 값을 채우세요. (secrets.toml 은 깃에 올라가지 않습니다)
# Streamlit Community Cloud에서는 앱 설정 > Secrets 에 같은 내용을 붙여 넣습니다.

OPENAI_API_KEY = "sk-..."

# 앱 접속 비밀번호(권장). 인터넷에 배포하면 주소를 아는 누구나 접속할 수 있으므로
# 내 API 요금이 도용되지 않도록 꼭 설정하세요.
APP_PASSWORD = "원하는-비밀번호"

# (선택) 사용할 모델. 비워 두면 app.py 의 DEFAULT_MODEL 을 씁니다.
